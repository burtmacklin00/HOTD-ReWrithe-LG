<?xml version="1.0" encoding="utf-8"?>
<!-- quest (2026-11-03, docs/quest.md): the Meta Quest build (tools/make_quest_apk.ps1). An immersive OpenXR app: the
     Quest's VR launcher category and Khronos' immersive-HMD category, head tracking required, the OpenXR runtime
     broker's queries (as the Khronos loader AAR's own manifest lists them). No game data and no icon of ours. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tawhid.hotdrewrithe"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION_NAME@"
    android:installLocation="auto">

    <uses-sdk android:minSdkVersion="32" android:targetSdkVersion="34" />

    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- vrship (2026-11-09): only "normal" permissions (granted at install, no prompt): VIBRATE (SDL's haptics, a
         gamepad's rumble), INTERNET (online co-op, docs/netplay.md). No storage permission: the game files are read
         from the app's own folder (Android/data/com.tawhid.hotdrewrithe/files: docs/quest.md) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the Khronos OpenXR loader: the runtime broker -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application
        android:label="HOTD ReWrithe"
        android:allowBackup="false"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:appCategory="game">

        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s|quest2|questpro" />

        <activity
            android:name="com.tawhid.hotdrewrithe.HotdActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:excludeFromRecents="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode|smallestScreenSize">
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
