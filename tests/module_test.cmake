# One module test (worker "tests", 2026-11-09; tests/CMakeLists.txt, docs/testing.md "CTest"): runs hotd headless with
# its own settings folder, a wall-clock timeout, and checks its output against a pass rule. CTest calls
#   cmake -DEXE=<hotd> -DNAME=<test> -DWORK=<folder> -DARGS=<a;b;..> -DPASS=<regex;..> [-DFAIL=<regex>] [-DNEED=arcade;pc;es]
#         [-DTIMEOUT=s] [-DRESULT=<file the run writes>] [-DRESULT_PASS=<regex on its last line>]
#         [-DPAIR=1 -DARGS2=<the second instance's args> -DPASS2=<regex;..>] -P module_test.cmake
# In ARGS: @ARCADE@ / @PC@ / @ES@ / @HARNESS@ become $HOTD_TEST_ARCADE / $HOTD_TEST_PC / $HOTD_TEST_ES /
# $HOTD_TEST_PC_HARNESS (default: $HOTD_TEST_PC), @WORK@ the test's folder. A NEEDed variable not set (or its path
# missing): exit 77 (CTest: Skipped). PASS: every regex must match the output; FAIL: none may (default: the crash /
# watchdog / memory-fault lines of tools/soak.ps1). PAIR: two instances at once (netplay on 127.0.0.1), the second
# started a second later; PASS applies to the first's output, PASS2 to the second's.
cmake_minimum_required(VERSION 3.21)
# (the lists come joined with "#|#": a ";" does not survive CTest's command line as a list separator)
foreach(v ARGS ARGS2 PASS PASS2 NEED ENVS)
    if(DEFINED ${v})
        string(REPLACE "#|#" ";" ${v} "${${v}}")
    endif()
endforeach()

# the sub-run of a pair: one instance, its output to a file (prints nothing: no pipe can fill)
if(SUB)
    if(DELAY)
        execute_process(COMMAND ${CMAKE_COMMAND} -E sleep ${DELAY})
    endif()
    set(ENV{HOTD_PREF_DIR} "${PREF}")
    execute_process(COMMAND ${EXE} ${ARGS} OUTPUT_FILE "${OUT}" ERROR_FILE "${OUT}.err" TIMEOUT ${TIMEOUT}
                    RESULT_VARIABLE rc)
    file(WRITE "${OUT}.rc" "${rc}")
    return()
endif()

if(NOT TIMEOUT)
    set(TIMEOUT 900)
endif()
set(_vars ARCADE HOTD_TEST_ARCADE PC HOTD_TEST_PC ES HOTD_TEST_ES)
set(_harness "$ENV{HOTD_TEST_PC_HARNESS}")
if(NOT _harness)
    set(_harness "$ENV{HOTD_TEST_PC}")
endif()
foreach(n ${NEED})
    string(TOUPPER "${n}" N)
    set(v "$ENV{HOTD_TEST_${N}}")
    if(N STREQUAL "HARNESS")
        set(v "${_harness}")
    endif()
    if(NOT v OR NOT EXISTS "${v}")
        message("SKIP ${NAME}: HOTD_TEST_${N} not set or missing")
        cmake_language(EXIT 77)
    endif()
endforeach()

foreach(kv ${ENVS})   # -DENVS=K=V;K2=V2: the runs' environment (both instances of a pair)
    string(FIND "${kv}" "=" eq)
    string(SUBSTRING "${kv}" 0 ${eq} k)
    math(EXPR eq "${eq} + 1")
    string(SUBSTRING "${kv}" ${eq} -1 v)
    set(ENV{${k}} "${v}")
endforeach()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/pref" "${WORK}/pref2")
function(expand out)
    set(r "")
    foreach(a ${ARGN})
        string(REPLACE "@ARCADE@" "$ENV{HOTD_TEST_ARCADE}" a "${a}")
        string(REPLACE "@PC@" "$ENV{HOTD_TEST_PC}" a "${a}")
        string(REPLACE "@ES@" "$ENV{HOTD_TEST_ES}" a "${a}")
        string(REPLACE "@HARNESS@" "${_harness}" a "${a}")
        string(REPLACE "@WORK@" "${WORK}" a "${a}")
        list(APPEND r "${a}")
    endforeach()
    set(${out} "${r}" PARENT_SCOPE)
endfunction()
expand(args ${ARGS})
if(NOT DEFINED FAIL)
    set(FAIL "GL error 0x|watchdog: |ROBUST: result=problem|access outside the mapped memory|nan_draws=[1-9]|[Aa]ssertion|abort\\(\\)|terminate called")
endif()

string(TIMESTAMP t0 "%s")
if(PAIR)
    expand(args2 ${ARGS2})
    execute_process(
        COMMAND ${CMAKE_COMMAND} -DSUB=1 "-DEXE=${EXE}" "-DARGS=${args}" "-DPREF=${WORK}/pref" "-DOUT=${WORK}/out1.txt"
                "-DTIMEOUT=${TIMEOUT}" -P "${CMAKE_CURRENT_LIST_FILE}"
        COMMAND ${CMAKE_COMMAND} -DSUB=1 "-DEXE=${EXE}" "-DARGS=${args2}" "-DPREF=${WORK}/pref2" "-DOUT=${WORK}/out2.txt"
                "-DTIMEOUT=${TIMEOUT}" -DDELAY=1 -P "${CMAKE_CURRENT_LIST_FILE}"
        TIMEOUT ${TIMEOUT})
    set(outs "")
    foreach(k 1 2)
        set(o "")
        if(EXISTS "${WORK}/out${k}.txt")
            file(READ "${WORK}/out${k}.txt" o)
        endif()
        if(EXISTS "${WORK}/out${k}.txt.err")
            file(READ "${WORK}/out${k}.txt.err" e)
            string(APPEND o "${e}")
        endif()
        set(out${k} "${o}")
        set(rc${k} "missing")
        if(EXISTS "${WORK}/out${k}.txt.rc")
            file(READ "${WORK}/out${k}.txt.rc" rc${k})
        endif()
    endforeach()
    set(out "${out1}")
    set(rc "${rc1}")
else()
    set(ENV{HOTD_PREF_DIR} "${WORK}/pref")
    execute_process(COMMAND ${EXE} ${args} OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT ${TIMEOUT} RESULT_VARIABLE rc)
    string(APPEND out "${err}")
    file(WRITE "${WORK}/out1.txt" "${out}")
endif()
string(TIMESTAMP t1 "%s")
math(EXPR secs "${t1} - ${t0}")

set(problems "")
if(NOT "${rc}" STREQUAL "0")
    list(APPEND problems "exit ${rc}")
endif()
if(PAIR AND NOT "${rc2}" STREQUAL "0")
    list(APPEND problems "second instance exit ${rc2}")
endif()
function(check_pass text rules tag)
    foreach(p ${rules})
        if(NOT text MATCHES "${p}")
            set(problems ${problems} "${tag}no line matching \"${p}\"" PARENT_SCOPE)
            set(problems ${problems} "${tag}no line matching \"${p}\"")
        endif()
    endforeach()
endfunction()
check_pass("${out}" "${PASS}" "")
if(PAIR)
    check_pass("${out2}" "${PASS2}" "second: ")
endif()
if(FAIL AND (out MATCHES "${FAIL}" OR (PAIR AND out2 MATCHES "${FAIL}")))
    list(APPEND problems "a failure line: ${CMAKE_MATCH_0}")
endif()
if(RESULT)
    expand(rf "${RESULT}")
    if(NOT EXISTS "${rf}")
        list(APPEND problems "no result file ${rf}")
    else()
        file(STRINGS "${rf}" lines)
        list(LENGTH lines n)
        if(n GREATER 0)
            math(EXPR n "${n} - 1")
            list(GET lines ${n} last)
        else()
            set(last "")
        endif()
        message("result: ${last}")
        if(NOT last MATCHES "${RESULT_PASS}")
            list(APPEND problems "result file's last line \"${last}\" does not match \"${RESULT_PASS}\"")
        endif()
    endif()
endif()

# the run's key lines (the pass rule's matches) for the log
foreach(p ${PASS})
    if(out MATCHES "[^\n]*${p}[^\n]*")
        message("  ${CMAKE_MATCH_0}")
    endif()
endforeach()
if(problems)
    list(JOIN problems "; " pj)
    message("FAILED ${NAME} (${secs} s): ${pj} (output: ${WORK}/out1.txt)")
    cmake_language(EXIT 1)
endif()
message("PASSED ${NAME} (${secs} s)")
